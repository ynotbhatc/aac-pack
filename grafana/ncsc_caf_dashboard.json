      "id": 28,
      "options": {
        "footer": {
          "enablePagination": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aac-compliance-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (\n  SELECT violations\n  FROM compliance_results\n  WHERE framework = 'ncsc_caf_4'\n    AND hostname IN ($hostname)\n  ORDER BY evaluation_timestamp DESC\n  LIMIT 1\n),\nnot_achieved AS (\n  SELECT jsonb_array_elements_text(violations) AS co FROM latest\n)\nSELECT\n  co,\n  CASE\n    WHEN co IN ('A3.a') THEN 'Asset Management'\n    WHEN co IN ('B5.a') THEN 'Resilience'\n    WHEN co IN ('C1.d','C1.f') THEN 'Security Monitoring'\n    WHEN co IN ('D1.a','D1.b','D1.c') THEN 'Response & Recovery'\n  END AS principle,\n  CASE\n    WHEN co IN (SELECT co FROM not_achieved WHERE co IN ('A3.a','B5.a','C1.d','C1.f','D1.a','D1.b','D1.c')) THEN 'not_achieved'\n    ELSE 'achieved'\n  END AS achievement\nFROM (VALUES ('A3.a'),('B5.a'),('C1.d'),('C1.f'),('D1.a'),('D1.b'),('D1.c')) t(co)",
          "refId": "A"
        }
      ],
      "title": "Phase 2 Governance CO Status",
      "type": "table"
    },
