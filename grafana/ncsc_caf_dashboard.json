      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aac-compliance-db"
          },
          "rawSql": "WITH latest AS (\n  SELECT violations, metadata->'partially_achieved_cos' AS partial_cos\n  FROM compliance_results\n  WHERE policy_name = 'ncsc_caf_4'\n  AND hostname IN ($hostname)\n  ORDER BY evaluation_timestamp DESC LIMIT 1\n),\nco_list(co, principle, description) AS (\n  VALUES\n    ('A3.a','A3','Asset Register'),\n    ('B2.a','B2','MFA Enforcement'),\n    ('B2.b','B2','Device Management'),\n    ('B2.c','B2','Privileged Access'),\n    ('B2.d','B2','Identity & Access Mgmt'),\n    ('B3.b','B3','Data in Transit'),\n    ('B3.c','B3','Stored Data'),\n    ('B3.d','B3','Mobile Data'),\n    ('B4.a','B4','Secure by Design'),\n    ('B4.b','B4','Secure Configuration'),\n    ('B4.c','B4','Secure Management'),\n    ('B4.d','B4','Vulnerability Management'),\n    ('B5.a','B5','Resilience Preparation'),\n    ('B5.b','B5','Design for Resilience'),\n    ('B5.c','B5','Backups'),\n    ('C1.a','C1','Logging Sources'),\n    ('C1.b','C1','Securing Logs'),\n    ('C1.c','C1','Generating Alerts'),\n    ('C1.d','C1','Alert Triage'),\n    ('C1.f','C1','Threat Intelligence'),\n    ('D1.a','D1','Response Planning'),\n    ('D1.b','D1','Response Capability'),\n    ('D1.c','D1','Exercises & Testing')\n)\nSELECT\n  c.principle AS \"Principle\",\n  c.co AS \"CO\",\n  c.description AS \"Description\",\n  CASE\n    WHEN l.violations ? c.co     THEN 0\n    WHEN l.partial_cos ? c.co    THEN 1\n    ELSE 2\n  END AS \"Status\"\nFROM co_list c, latest l\nORDER BY c.co",
          "format": "table",
          "rawQuery": true
        }
