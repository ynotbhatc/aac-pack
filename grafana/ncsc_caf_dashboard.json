      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "aac-compliance-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  ROUND((7 - COUNT(*))::numeric / 7 * 100, 0) AS value\nFROM (\n  SELECT jsonb_array_elements_text(violations) AS co\n  FROM compliance_results\n  WHERE framework = 'ncsc_caf_4'\n    AND hostname IN ($hostname)\n  ORDER BY evaluation_timestamp DESC\n  LIMIT 1\n) sub\nWHERE co IN ('A3.a','B5.a','C1.d','C1.f','D1.a','D1.b','D1.c')",
          "refId": "A"
        }
      ],
      "title": "Phase 2 Achievement %",
      "type": "stat"
