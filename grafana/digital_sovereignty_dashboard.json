{
  "uid": "digital-sovereignty-001",
  "title": "Digital Sovereignty Compliance",
  "tags": ["digital-sovereignty", "aac", "compliance"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Sovereignty Level",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^value$/" },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "text": { "valueSize": 20 }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "5": { "text": "SOVEREIGN",          "color": "green",  "index": 0 },
                "4": { "text": "HIGH ASSURANCE",     "color": "blue",   "index": 1 },
                "3": { "text": "MODERATE ASSURANCE", "color": "yellow", "index": 2 },
                "2": { "text": "LIMITED ASSURANCE",  "color": "orange", "index": 3 },
                "1": { "text": "NON-SOVEREIGN",       "color": "red",    "index": 4 },
                "0": { "text": "UNKNOWN",             "color": "gray",   "index": 5 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "value" },
            "properties": [{ "id": "custom.type", "value": "string" }]
          }
        ]
      },
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "aac-compliance-db" },
        "rawSql": "SELECT CASE metadata->>'sovereignty_level' WHEN 'SOVEREIGN' THEN 5 WHEN 'HIGH_ASSURANCE' THEN 4 WHEN 'MODERATE_ASSURANCE' THEN 3 WHEN 'LIMITED_ASSURANCE' THEN 2 WHEN 'NON_SOVEREIGN' THEN 1 ELSE 0 END AS value FROM compliance_results WHERE policy_name = 'Digital Sovereignty' ORDER BY evaluation_timestamp DESC LIMIT 1",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "title": "Compliance Score (%)",
      "type": "gauge",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "aac-compliance-db" },
        "rawSql": "SELECT compliance_percentage AS value FROM compliance_results WHERE policy_name = 'Digital Sovereignty' ORDER BY evaluation_timestamp DESC LIMIT 1",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "title": "Controls Passing",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "aac-compliance-db" },
        "rawSql": "SELECT passed_controls AS value FROM compliance_results WHERE policy_name = 'Digital Sovereignty' ORDER BY evaluation_timestamp DESC LIMIT 1",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "title": "Open Violations",
      "type": "stat",
      "gridPos": { "x": 11, "y": 0, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "aac-compliance-db" },
        "rawSql": "SELECT failed_controls AS value FROM compliance_results WHERE policy_name = 'Digital Sovereignty' ORDER BY evaluation_timestamp DESC LIMIT 1",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "title": "Domains Assessed",
      "type": "stat",
      "gridPos": { "x": 14, "y": 0, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "aac-compliance-db" },
        "rawSql": "SELECT CAST(metadata->>'domains_assessed' AS INT) AS value FROM compliance_results WHERE policy_name = 'Digital Sovereignty' ORDER BY evaluation_timestamp DESC LIMIT 1",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "title": "Critical Violations",
      "type": "stat",
      "gridPos": { "x": 17, "y": 0, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "aac-compliance-db" },
        "rawSql": "SELECT COALESCE(CAST(metadata->>'critical_count' AS INT), 0) AS value FROM compliance_results WHERE policy_name = 'Digital Sovereignty' ORDER BY evaluation_timestamp DESC LIMIT 1",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "id": 7,
      "title": "Compliance Score Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 95 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "aac-compliance-db" },
        "rawSql": "SELECT evaluation_timestamp AS time, compliance_percentage AS \"Compliance %\" FROM compliance_results WHERE policy_name = 'Digital Sovereignty' AND $__timeFilter(evaluation_timestamp) ORDER BY evaluation_timestamp",
        "format": "time_series",
        "refId": "A"
      }]
    },
    {
      "id": 8,
      "title": "Controls Passing vs Failing Over Time",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Passing" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Failing" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "aac-compliance-db" },
        "rawSql": "SELECT evaluation_timestamp AS time, passed_controls AS \"Passing\", failed_controls AS \"Failing\" FROM compliance_results WHERE policy_name = 'Digital Sovereignty' AND $__timeFilter(evaluation_timestamp) ORDER BY evaluation_timestamp",
        "format": "time_series",
        "refId": "A"
      }]
    },
    {
      "id": 9,
      "title": "Assessment History",
      "type": "table",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "options": {
        "sortBy": [{ "displayName": "Timestamp", "desc": true }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Score %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 60 }, { "color": "green", "value": 95 }] } },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Level" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "SOVEREIGN": { "color": "green" } } },
                { "type": "value", "options": { "HIGH_ASSURANCE": { "color": "blue" } } },
                { "type": "value", "options": { "NON_SOVEREIGN": { "color": "red" } } }
              ]}
            ]
          }
        ]
      },
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "aac-compliance-db" },
        "rawSql": "SELECT evaluation_timestamp AS \"Timestamp\", metadata->>'organization' AS \"Organization\", metadata->>'sovereignty_level' AS \"Level\", compliance_percentage AS \"Score %\", passed_controls AS \"Passing\", failed_controls AS \"Failing\", CAST(metadata->>'domains_assessed' AS INT) AS \"Domains\", COALESCE(CAST(metadata->>'critical_count' AS INT),0) AS \"Critical\", COALESCE(CAST(metadata->>'high_count' AS INT),0) AS \"High\" FROM compliance_results WHERE policy_name = 'Digital Sovereignty' AND $__timeFilter(evaluation_timestamp) ORDER BY evaluation_timestamp DESC",
        "format": "table",
        "refId": "A"
      }]
    }
  ]
}
