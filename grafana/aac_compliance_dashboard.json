      "targets": [
        {
          "rawSql": "SELECT AVG(compliance_percentage) AS value FROM compliance_results WHERE (policy_name ILIKE 'CIS%' OR policy_name ILIKE 'cis_m365_v7%') AND $__timeFilter(evaluation_timestamp)",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aac-compliance-db"
