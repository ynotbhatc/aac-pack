          "rawSql": "\n                SELECT EXTRACT(EPOCH FROM evaluation_timestamp)*1000 AS time,\n                       CASE WHEN (metadata->>'compliant')::boolean IS TRUE THEN 1 ELSE 0 END AS value\n                FROM compliance_results\n                WHERE policy_name IN ('AMI Head-End Security', 'AMI Device Compliance', 'AMI NIST IR 7628 Rev 1')\n                ORDER BY evaluation_timestamp DESC LIMIT 1",
          "refId": "A"
        }
      ],
