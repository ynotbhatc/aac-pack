          "rawSql": "\n                SELECT evaluation_timestamp                         AS \"Time\",\n                       policy_name                                  AS \"Framework\",\n                       policy_version                               AS \"Version\",\n                       ROUND(compliance_percentage, 1)              AS \"Score\",\n                       total_controls                               AS \"Total\",\n                       passed_controls                              AS \"Passed\",\n                       failed_controls                              AS \"Failed\",\n                       (metadata->>'compliant')::text               AS \"Compliant\",\n                       metadata->>'utility'                         AS \"Utility\"\n                FROM compliance_results\n                WHERE policy_name IN ('AMI Head-End Security', 'AMI Device Compliance', 'AMI NIST IR 7628 Rev 1')\n                ORDER BY evaluation_timestamp DESC\n                LIMIT 30",
