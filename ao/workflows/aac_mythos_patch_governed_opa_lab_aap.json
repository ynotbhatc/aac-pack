    {
      "id": "agent_blast_radius",
      "name": "Agent: Blast Radius",
      "type": "agentic",
      "position": {
        "x": 272.79593455966744,
        "y": -423.5716338942258
      },
      "parameters": {
        "prompt": "You measure ONE dimension of patch risk: BLAST RADIUS — how many systems, in which environments, a patch of the in-scope CVEs would touch. Facts from Identify: affected_count=${identify.artifacts.affected_count}, affected_cves=${identify.artifacts.affected_cves}, max_severity=${identify.artifacts.max_severity}, kev_present=${identify.artifacts.kev_present}, has_vendor_fix=${identify.artifacts.has_vendor_fix}, eol_exposed=${identify.artifacts.eol_exposed}. Target host: ${trigger.target_hostname}. CVEs in scope: ${trigger.cve_ids}. Use ONLY these read-only AAP MCP tools: api_hosts_read, api_hosts_list, api_hosts_groups_list, api_groups_read, api_groups_list, api_inventories_read, api_inventories_list — do NOT request host variable data (it is denied by governance policy and you do not need it; classify from inventory names, group names and membership) to establish how widely the target host's group/environment spreads. impact = size x spread of the affected estate; importance = how critical what sits inside that spread is. Return JSON only: {impact, importance, reasons, confidence}. Both scores 0-100. impact = how severe the consequences in YOUR dimension are; importance = how much weight your dimension deserves in THIS decision given the context. You do NOT classify risk — a policy engine derives the risk band from your two scores; report measurements, not conclusions. reasons: specific factual reasons joined by '; '. confidence 0-1 reflecting how much real data you had (thin data means low confidence; never invent facts).",
        "llm_model_id": "c3120842-0fad-498e-871a-0ff4488f601f",
        "credential_id": "72fd4b39-eea4-433d-baa3-7f5c70fe97f0",
        "response_schema": {
          "type": "object",
          "required": [
            "impact",
            "importance",
            "reasons",
            "confidence"
          ],
          "properties": {
            "impact": {
              "type": "integer",
              "maximum": 100,
              "minimum": 0,
              "description": "How severe the consequences in this dimension are"
            },
            "reasons": {
              "type": "string",
              "description": "Specific factual reasons, '; '-joined"
            },
            "confidence": {
              "type": "number",
              "maximum": 1,
              "minimum": 0
            },
            "importance": {
              "type": "integer",
              "maximum": 100,
              "minimum": 0,
              "description": "How much weight this dimension deserves in this decision"
            }
          }
        },
        "integration_connections": [
          {
            "credential_id": "8044f524-4dfe-48e2-a7d4-a0ae8ad5b13a",
            "integration_id": "f3dbc4a4-0cc4-4527-a376-a766917ea2ce"
          }
        ],
        "tool_selection_strategy": "ALL"
      }
    },
