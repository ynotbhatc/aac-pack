    {
      "id": "triage_agent",
      "name": "AI Drift Triage",
      "type": "agentic",
      "position": {
        "x": 349.2732739754555,
        "y": -128.46001015684655
      },
      "parameters": {
        "prompt": "You are a configuration-drift governance coordinator for a golden-image baseline. A drift check just ran on host ${trigger.target_hostname}. Read the set_stats artifacts: any_drift=${identify.artifacts.any_drift}, critical_drift=${identify.artifacts.critical_drift}, baseline_compliant=${identify.artifacts.baseline_compliant}, drifted_key=${identify.artifacts.drifted_key}. You may use the AAP Inventory MCP tools for host context. Assess whether this is a routine deviation safe to auto-roll-back, a security-relevant/critical change that should require human approval before rollback, or a case with no usable baseline that needs investigation. A policy engine makes the final routing decision; your recommendation is only an input.",
        "llm_model_id": "c3120842-0fad-498e-871a-0ff4488f601f",
        "credential_id": "72fd4b39-eea4-433d-baa3-7f5c70fe97f0",
        "response_schema": {
          "type": "object",
          "required": [
            "route",
            "reasoning",
            "confidence",
            "severity"
          ],
          "properties": {
            "route": {
              "enum": [
                "auto_rollback",
                "approve_rollback",
                "investigate"
              ],
              "type": "string"
            },
            "severity": {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            "reasoning": {
              "type": "string"
            },
            "confidence": {
              "type": "number"
            }
          }
        },
        "integration_connections": [
          {
            "credential_id": "8044f524-4dfe-48e2-a7d4-a0ae8ad5b13a",
            "integration_id": "f3dbc4a4-0cc4-4527-a376-a766917ea2ce"
          }
        ],
        "tool_selection_strategy": "ALL"
      }
    },
    {
      "id": "route_switch",
      "name": "Route",
      "type": "switch",
      "position": {
        "x": 770.8507219340878,
        "y": 237.78490915179708
      },
      "parameters": {
        "cases": [
          {
            "port": "case_0",
            "label": "Auto rollback",
            "condition": "${opa_gate.body.result.route} == 'auto'"
          },
          {
            "port": "case_1",
            "label": "Approval required",
            "condition": "${opa_gate.body.result.route} == 'approve'"
          },
          {
            "port": "case_2",
            "label": "Investigate",
            "condition": "${opa_gate.body.result.route} == 'investigate'"
          },
          {
            "port": "case_3",
            "label": "Hold (managed change / rollback paused)",
            "condition": "${opa_gate.body.result.route} == 'hold'"
          }
        ],
        "default_port": "default"
      }
    },
    {
      "id": "approval_patch",
